# Reference only. make backend-up creates private .runtime/public.env automatically.
# make demo creates separate .runtime/demo.env credentials, containers and volumes.
POSTGRES_USER=clearpath
POSTGRES_DB=clearpath
POSTGRES_PASSWORD=REPLACE_WITH_A_GENERATED_RANDOM_PASSWORD
CLEARPATH_DATABASE_URL=postgresql+psycopg://clearpath:REPLACE_WITH_A_GENERATED_RANDOM_PASSWORD@db:5432/clearpath
CLEARPATH_API_KEY=REPLACE_WITH_A_GENERATED_RANDOM_KEY_AT_LEAST_32_CHARACTERS
CLEARPATH_DATA_MODE=public
BACKEND_API_PORT=8000
BACKEND_DB_PORT=55432
